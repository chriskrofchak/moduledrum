Moduledrum's patch for dsp56300 (sd88me's fork at 26558e5401fa134a013eca8dbb8c5ecde837ec55, ext/dsp56300): JIT fixes
that make the JIT bit-exact with the interpreter on the Machinedrum voice DSP program (.clew increment 0011, found by
running both in lockstep). cmake/dsp56300.cmake applies it to the checkout at configure time; every change is marked
"MD patch" in the source. Only JIT code changes: the interpreter builds the same code as before.

1. jitblock.cpp, JitBlock::getInfo: a REP and the instruction it repeats could end up in two blocks (the repeated
   instruction ended the block, e.g. because it reads an M register written earlier in the block). JitOps::rep_exec emits
   the repeated instruction with the REP anyway, so the block ran all repetitions and left PC on the repeated
   instruction, which the next block then ran once more. Now the pair always stays in one block, or the block ends
   before the REP.
2. jitdspregpoolregpair.cpp, JitRegPoolRegPair::get: a 48-bit read of x or y merged written halves (x0/x1/y0/y1) into
   the combined register and cleared the halves' written flags. The combined register is a read cache that is never
   stored, so the write was lost: "move x:(r1),y1 / sub y,a / nop" in a block left the old y1 in the DSP registers.
   (Changes the audio of 5 of the 64 kits in Elektron's preset file.)
3. jitops_alu_aarch64.cpp, jitops_alu_x64.cpp, JitOps::alu_asl: on aarch64, ASL by zero (#0, or a shift register that
   holds 0) set C for every negative value (C was bit 56 of the sign-extended value); and on both back ends a multi-bit
   ASL never set L when it set V. The interpreter clears C for a zero shift and sets L along with V.

diff --git a/source/dsp56kEmu/jitblock.cpp b/source/dsp56kEmu/jitblock.cpp
index a16f69e0..9deb79c0 100644
--- a/source/dsp56kEmu/jitblock.cpp
+++ b/source/dsp56kEmu/jitblock.cpp
@@ -65,18 +65,27 @@ namespace dsp56k
 		auto writesM = RegisterMask::None;
 		auto readsM = RegisterMask::None;
 
+		// MD patch: JitOps::rep_exec emits a REP together with the instruction it repeats, so the two must not be split
+		// across blocks: a block that ended after the REP still ran the repeated instruction, but left the PC on it, and
+		// the next block ran it once more. The repeated instruction always joins the REP's block; a REP whose repeated
+		// instruction could not join the block (it reads an M register written earlier in the block, or its address is
+		// taken by existing code or is volatile) ends the block before the REP instead.
+		bool nextIsRepeated = false;
+
 		while(shouldEmit)
 		{
 			const auto pc = _pc + numWords;
+			const bool isRepeated = nextIsRepeated;	// MD patch
+			nextIsRepeated = false;
 
-			if(pc >= pcMax)
+			if(pc >= pcMax && !isRepeated)
 			{
 				terminationReason = JitBlockInfo::TerminationReason::PcMax;
 				break;
 			}
 
 			// never overwrite code that already exists
-			if(pc < _cache.size() && _cache[pc].block)
+			if(pc < _cache.size() && _cache[pc].block && !isRepeated)
 			{
 				terminationReason = JitBlockInfo::TerminationReason::ExistingCode;
 				break;
@@ -125,7 +134,7 @@ namespace dsp56k
 			// while an M register change causes a mode change, we can continue this block as long as that M register is not read in a subsequent instruction
 			if((writesM & readsM) != RegisterMask::None)
 			{
-				if(numInstructions)
+				if(numInstructions && !isRepeated)
 				{
 					_info.terminationReason = JitBlockInfo::TerminationReason::ModeChange;
 					break;
@@ -133,8 +142,8 @@ namespace dsp56k
 			}
 
 			// for a volatile P address, if you have some code, break now. if not, generate this one op, and then return.
-			if (_volatileP.find(pc) != _volatileP.end() || 
-				(_volatileP.find(pc+1) != _volatileP.end() && Opcodes::getOpcodeLength(opA, instA, instB) == 2))
+			if (!isRepeated && (_volatileP.find(pc) != _volatileP.end() ||
+				(_volatileP.find(pc+1) != _volatileP.end() && Opcodes::getOpcodeLength(opA, instA, instB) == 2)))
 			{
 				terminationReason = JitBlockInfo::TerminationReason::VolatileP;
 				if (numInstructions)
@@ -144,6 +153,34 @@ namespace dsp56k
 
 			const auto isRep = flags & (OpFlagRepDynamic | OpFlagRepImmediate);
 
+			// MD patch: would the repeated instruction be refused by the checks above? Then end the block before the REP.
+			if(isRep && numInstructions && shouldEmit)
+			{
+				const TWord pcRep = pc + Opcodes::getOpcodeLength(opA, instA, instB);
+				TWord repA, repB;
+				_dsp.memory().getOpcode(pcRep, repA, repB);
+				Instruction repInstA, repInstB;
+				opcodes.getInstructionTypes(repA, repInstA, repInstB);
+				auto repWritten = RegisterMask::None;
+				auto repRead = RegisterMask::None;
+				Opcodes::getRegisters(repWritten, repRead, repA, repInstA, repInstB);
+
+				if(pcRep >= pcMax)
+					terminationReason = JitBlockInfo::TerminationReason::PcMax;
+				else if(pcRep < _cache.size() && _cache[pcRep].block)
+					terminationReason = JitBlockInfo::TerminationReason::ExistingCode;
+				else if((repRead & writesM) != RegisterMask::None)
+					terminationReason = JitBlockInfo::TerminationReason::ModeChange;
+				else if(_volatileP.find(pcRep) != _volatileP.end())
+					terminationReason = JitBlockInfo::TerminationReason::VolatileP;
+				else
+					terminationReason = JitBlockInfo::TerminationReason::None;
+
+				if(terminationReason != JitBlockInfo::TerminationReason::None)
+					break;
+			}
+			nextIsRepeated = isRep;
+
 			writtenRegs |= written;
 			readRegs |= read;
 
