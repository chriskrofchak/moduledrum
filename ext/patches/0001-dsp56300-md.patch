diff --git a/source/dsp56kEmu/jitops_alu_aarch64.cpp b/source/dsp56kEmu/jitops_alu_aarch64.cpp
index 4d2e9864..768ec380 100644
--- a/source/dsp56kEmu/jitops_alu_aarch64.cpp
