@@ -66,6 +66,18 @@ namespace dsp56k
 		if (_abDst != _abSrc)
 			m_dspRegs.getALU(alu.get(), _abSrc);
 
+		// MD patch: carry is the last bit shifted out, and cleared for a shift amount of zero (as in the interpreter and the
+		// x64 JIT). Bit 56 of the zero-extended 56-bit value shifted left is that bit and stays clear for a zero shift; bit 56
+		// of the sign-extended copy below is the sign, so taking C from it set C for any negative value shifted by zero.
+		{
+			const RegGP c(m_block);
+			if(_v)
+				m_asm.lsl(c, alu, _v->get());
+			else
+				m_asm.lsl(c, alu, asmjit::Imm(_immediate));
+			copyBitToCCR(c, 56, CCRB_C);
+		}
+
 		signextend56to64(alu);
 
 		const RegGP oldAlu(m_block);
@@ -76,9 +88,6 @@ namespace dsp56k
 		else
 			m_asm.lsl(alu, alu, asmjit::Imm(_immediate));
 
-		// carry is the last bit shifted out so in our case its 56
-		copyBitToCCR(alu, 56, CCRB_C);
-
 		// Overflow: Set if Bit 55 is changed any time during the shift operation, cleared otherwise.
 		// The easiest way to check this is to shift back and compare if the initial alu value is identical ot the backshifted one
 		{
@@ -92,6 +101,7 @@ namespace dsp56k
 		}
 
 		ccr_update_ifNotZero(CCRB_V);
+		ccr_l_update_by_v();	// MD patch: L is set when V is (sticky), as in the interpreter's alu_asl
 
 		m_dspRegs.mask56(alu);
 
